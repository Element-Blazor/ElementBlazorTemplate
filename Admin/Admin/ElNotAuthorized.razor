@inherits ElNotAuthorizedBase

@if (requireInitilize.HasValue)
{
    @if (requireInitilize.Value)
    {
        if (CreatePage != null)
        {
            <ElDynamicComponent Component="CreatePage"></ElDynamicComponent>
        }
        else
        {
            <ElCreateSuperUser></ElCreateSuperUser>
        }
    }
    else
    {
        if (LoginPage != null)
        {
            <ElDynamicComponent Component="LoginPage"></ElDynamicComponent>
        }
        else
        {
            <ElLogin DefaultUser="DefaultUser"></ElLogin>
        }
    }
}

