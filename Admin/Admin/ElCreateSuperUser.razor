@inherits BCreateSuperUserBase
<div class="login-container">
    <ElForm @ref="form">
        <div class="title-container">
            <h3 class="title">
                创建超级管理员
            </h3>
        </div>
        <ElFormItem Required="true" TValue="string" Error="请输入账号" Prop="@nameof(LoginInfoModel.Username)">
            <ElInput PrefixIcon="el-icon-user-solid" Value="DefaultUser?.Username" TValue="string" Placeholder="账号"></ElInput>
        </ElFormItem>
        <ElFormItem Required="true" TValue="string" Error="请输入密码" Prop="@nameof(LoginInfoModel.Password)">
            <ElInput PrefixIcon="el-icon-lock" SuffixIcon="el-icon-view" OnSuffixIconClick="TogglePassword" Type="@passwordType" Value="DefaultUser?.Password" TValue="string" Placeholder="密码"></ElInput>
        </ElFormItem>
        <ElFormActionItem>
            <ElButton Type="@ButtonType.Primary" OnClick="CreateAsync" Style="width:100%;">创建</ElButton>
        </ElFormActionItem>
    </ElForm>
</div>

