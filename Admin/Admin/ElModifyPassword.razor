@inherits BModifyPasswordBase
<ElForm Style="padding:0px 50px;" @ref="form">
    <ElFormItem Required="true" TValue="string" Error="请输入旧密码" Prop="@nameof(ModifyPasswordModel.OldPassword)">
        <ElInput PrefixIcon="el-icon-lock" Type="@InputType.Password" TValue="string" Placeholder="旧密码"></ElInput>
    </ElFormItem>
    <ElFormItem Required="true" TValue="string" Error="请输入新密码" Prop="@nameof(ModifyPasswordModel.NewPassword)">
        <ElInput PrefixIcon="el-icon-lock" Type="@InputType.Password" TValue="string" Placeholder="新密码"></ElInput>
    </ElFormItem>
    <ElFormActionItem>
        <ElButton Type="@ButtonType.Primary" OnClick="ModifyAsync" Style="width:100%;">修改</ElButton>
    </ElFormActionItem>
</ElForm>

