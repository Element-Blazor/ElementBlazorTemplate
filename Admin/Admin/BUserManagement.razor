@page "/user/list"
@inherits BUserManagementBase
@attribute [Resource("userList", "用户列表")]
<ElAuthorizeView Roles="@Roles">
    @if (CanCreate)
    {
        <ElButtonGroup>
            <ElButton Type="@ButtonType.Primary" Size="@ButtonSize.Small" OnClick="CreateUserAsync">创建用户</ElButton>
        </ElButtonGroup>
    }
    <ElTable DataSource="Users" @ref="table" IgnoreProperties="new string[] { nameof(UserModel.Password),nameof(UserModel.Id),nameof(UserModel.RoleIds)}" HasSelectionColumn="false">
        <ElTableColumns>
            @if (CanUpdate || CanDelete)
            {
                <ElTableTemplateColumn Text="操作" Context="user">
                    @if (CanUpdate)
                    {
                        <ElButton Type="@ButtonType.Primary" Size="@ButtonSize.Small" OnClick="@(e => EditAsync(user))">编辑</ElButton>
                    }
                    @if (CanDelete)
                    {
                        <ElButton Type="@ButtonType.Danger" Size="@ButtonSize.Small" OnClick="@(e => Del(user))">删除</ElButton>
                    }

                    @if (CanReset)
                    {
                        <ElButton Type="@ButtonType.Info" Size="@ButtonSize.Small" OnClick="@(e => Reset(user))">重置密码</ElButton>
                    }
                </ElTableTemplateColumn>
            }
        </ElTableColumns>
    </ElTable>
</ElAuthorizeView>