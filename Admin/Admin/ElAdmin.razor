@inherits ElAdminBase
<ElPopup></ElPopup>
<CascadingAuthenticationState>
    <CascadingValue TValue="ElAdminBase" Value="this">
        <AuthorizeView>
            <Authorized>
                <ElLayout WestWidth="@NavigationWidth">
                    <West>
                        <ElCard Style="background-color:#20222A;" Shadow="@ShadowShowType.Never">
                            <Header>
                                @NavigationTitle
                            </Header>
                            <Body>
                                <ElMenu Mode="@MenuMode.Vertical" @bind-ActiveItem="@CurrentMenu" EnableAlwaysRender="true" DefaultActive="@defaultMenuIndex" BackgroundColor="#20222A" ActiveTextColor="#FFFFFF" TextColor="rgba(255,255,255,.7)" HoverColor="#434A50">
                                    @foreach (var menu in Menus)
                                    {
                                        if (menu.Children != null && menu.Children.Any())
                                        {
                                            @if (!RequireHide(menu.Children))
                                            {
                                                <ElSubMenu Label="@menu.Label" Icon="@menu.Icon">
                                                    @foreach (var children in menu.Children)
                                                    {
                                                        @if (!RequireHide(children))
                                                        {
                                                            <ElMenuItem Route="@children.Route" Icon="@children.Icon" Index="@children.Name" Model="@children">@children.Label</ElMenuItem>
                                                        }
                                                    }
                                                </ElSubMenu>
                                            }
                                        }
                                        else
                                        {
                                            @if (!RequireHide(menu))
                                            {
                                                <ElMenuItem Route="@menu.Route" Icon="@menu.Icon" Index="@menu.Name" Model="@menu">@menu.Label</ElMenuItem>
                                            }
                                        }
                                    }
                                </ElMenu>
                            </Body>
                        </ElCard>
                    </West>
                    <Center>
                        <ElForm @ref="form"></ElForm>
                        <div class="navbar">
                            <div class="tools">
                                <ElBreadcrumb @ref="breadcrumb">
                                    <ElBreadcrumbItem>@BreadcrumbTitle</ElBreadcrumbItem>
                                    @if (CurrentMenu != null)
                                    {
                                        <ElBreadcrumbItem>@(((MenuModel)CurrentMenu.Model).Title)</ElBreadcrumbItem>
                                    }
                                </ElBreadcrumb>
                            </div>
                            <div class="fill"></div>
                            <div class="tools">

                                <ElDropdown Style="cursor:pointer;">
                                    <Trigger>
                                        <span class="el-dropdown-link">
                                            @username  <i class="el-icon-arrow-down el-icon--right"></i>
                                        </span>
                                    </Trigger>
                                    <Items>
                                        @if (PersonMenus != null)
                                        {
                                            @PersonMenus
                                        }
                                        <ElDropdownItem OnClick="ModifyPasswordAsync">娣囶喗鏁肩€靛棛鐖</ElDropdownItem>
                                        <ElDropdownItem OnClick="LogoutAsync">濞夈劑鏀㈤惂璇茬秿</ElDropdownItem>
                                    </Items>
                                </ElDropdown>
                            </div>
                        </div>
                        <ElTabs Type="@TabType.Card" DataSource="Tabs" @ref="tab">
                        </ElTabs>
                    </Center>
                </ElLayout>
            </Authorized>
            <NotAuthorized>
                <ElNotAuthorized LoginPage="LoginPage" CreatePage="CreatePage" DefaultUser="DefaultUser"></ElNotAuthorized>
            </NotAuthorized>
        </AuthorizeView>
    </CascadingValue>
</CascadingAuthenticationState>

