@page "/about"

<section class="about-page">
    <div class="about-hero">
        <div>
            <span class="doc-page__category">About</span>
            <h1>Client Render Template</h1>
            <p>This template shows a browser-rendered Element-Blazor application shell and reusable component documentation layout.</p>
            <div class="about-actions">
                <ElButton Type="@ButtonType.Primary" Tag="a" Href="https://github.com/Element-Blazor/Element-Blazor" Target="_blank" Rel="noopener noreferrer" Icon="el-icon-star-off">GitHub</ElButton>
                <ElButton Tag="a" Href="https://www.nuget.org/packages/Element/" Target="_blank" Rel="noopener noreferrer" Icon="el-icon-download">NuGet</ElButton>
            </div>
        </div>
        <div class="about-hero__panel" aria-label="Template status">
            <ElTag Type="@TagType.Success" Theme="@TagTheme.Light">Element-Blazor</ElTag>
            <ElTag Type="@TagType.Info" Theme="@TagTheme.Light">WebAssembly</ElTag>
            <ElTag Type="@TagType.Warning" Theme="@TagTheme.Light">Template</ElTag>
        </div>
    </div>

    <div class="about-grid">
        <ElCard Shadow="@ShadowShowType.Never" Cls="about-card">
            <Header>
                <span>Template Scope</span>
            </Header>
            <Body>
                <p>Use this project as a starting point for a client-rendered Blazor app that depends on Element-Blazor components.</p>
                <p>Project-specific community content and deployment assets belong in the consuming application, not in the template.</p>
            </Body>
        </ElCard>

        <ElCard Shadow="@ShadowShowType.Never" Cls="about-card">
            <Header>
                <span>Links</span>
            </Header>
            <Body>
                <div class="about-links">
                    <ElLink Type="@LinkType.Primary" Href="https://github.com/Element-Blazor/Element-Blazor" Target="_blank" Rel="noopener noreferrer" Icon="el-icon-link">Element-Blazor Repository</ElLink>
                    <ElLink Type="@LinkType.Primary" Href="https://www.nuget.org/packages/Element/" Target="_blank" Rel="noopener noreferrer" Icon="el-icon-link">Element NuGet Package</ElLink>
                    <ElLink Type="@LinkType.Primary" Href="https://www.nuget.org/packages/Element.Markdown/" Target="_blank" Rel="noopener noreferrer" Icon="el-icon-link">Element.Markdown NuGet Package</ElLink>
                    <ElLink Type="@LinkType.Primary" Href="https://element-plus.org/" Target="_blank" Rel="noopener noreferrer" Icon="el-icon-link">Element Plus Design Reference</ElLink>
                </div>
            </Body>
        </ElCard>
    </div>
</section>
