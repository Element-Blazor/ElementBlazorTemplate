@inherits PageBase
@if (demos == null)
{
    @("拼命加载�?..")
}
else
{
    foreach (var demo in demos)
    {
        <ElCard>
            <Header>
                @demo.Title
            </Header>
            <Body>
                <ElTabs Type="@TabType.BorderCard">
                    <ElTabPane Title="运行效果" IsActive="true" Prop="display">
                        <ElDynamicComponent Component="@demo.Demo"></ElDynamicComponent>
                    </ElTabPane> 
                    <ElTabPane Title="示例代码">
                        <ElTabs DataSource="demo.Options">
                        </ElTabs>
                    </ElTabPane>
                </ElTabs>
            </Body>
        </ElCard>
    }
    <style>
        .el-card {
            margin-bottom: 10px;
        }
    </style>
}